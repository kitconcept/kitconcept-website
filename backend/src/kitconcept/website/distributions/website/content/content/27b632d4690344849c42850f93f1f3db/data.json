            "fields": [
              "uploade_your_file"
            ],
            "id": "more",
            "title": "More fields"
          }
        ],
        "properties": {
          "message": {
            "default": "I would like to know more about...",
            "description": "Send us a message",
            "factory": "textarea",
            "id": "message",
            "placeholder": "I would like to know more about...",
            "title": "Message",
            "type": "string",
            "values": "",
            "widget": "textarea"
          },
