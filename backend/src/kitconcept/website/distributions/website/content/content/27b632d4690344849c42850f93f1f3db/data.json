            "id": "name",
            "placeholder": "Jane Doe",
            "title": "Name",
            "type": "string",
            "values": ""
          },
          "uploade_your_file": {
            "factory": "File Upload",
            "id": "uploade_your_file",
            "title": "Uploade your file",
            "type": "object"
          }
        },
        "required": [
          "name"
        ]
      },
      "sender": "noreply@plone.org",
      "sender_name": "Plone",
